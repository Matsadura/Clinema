# ---------------------------------------------------------------------------
# Clinema configuration. Copy to `.env` (git-ignored) and fill in the values:
#     cp .env.example .env
# Used by docker compose (env_file) and by the Flask API in local development.
# ---------------------------------------------------------------------------

# development | production   (production enforces a strong JWT secret)
APP_ENV=production

# --- Required third-party API keys -----------------------------------------
# https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=
# https://console.groq.com/keys
GROQ_API_KEY=
# https://www.themoviedb.org/settings/api  (v3 "API Key")
TMDB_API_KEY=

# --- Auth ------------------------------------------------------------------
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
# Token lifetime in hours (default 24)
# JWT_EXPIRES_HOURS=24

# --- AI model --------------------------------------------------------------
# Comma-separated, in order of preference: if Groq retires a model the next
# one is used automatically. Leave empty for the built-in default.
GROQ_MODEL=openai/gpt-oss-120b,openai/gpt-oss-20b
# Seconds before the LLM call is abandoned and the genre fallback is used
# LLM_TIMEOUT=20

# --- Database (MySQL) ------------------------------------------------------
MYSQL_DATABASE=clinema
MYSQL_USER=clinema
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too
# Host the API connects to (compose sets this to `db` automatically)
# DB_HOST=localhost
# Or override everything with a full SQLAlchemy URL:
# DATABASE_URL=mysql+pymysql://user:pass@host:3306/clinema

# --- HTTP ------------------------------------------------------------------
# Comma-separated origins allowed to call the API cross-origin. Not needed when
# the SPA is served through the bundled nginx (same origin). Dev default:
# CORS_ORIGINS=http://localhost:5173
# Rate-limit storage (default in-memory per worker), e.g. redis://redis:6379
# RATELIMIT_STORAGE_URI=memory://
# Host port the web container is published on
# WEB_PORT=8080
